cabal-version: 3.4
name: hauth
version: 0.0.0.0
synopsis: Postgres-native authentication service
description:
  Hauth is a Postgres-native authentication service written in Haskell.
author: Thales Maciel
maintainer: Thales Maciel
category: Web
build-type: Simple
tested-with: GHC ==9.4.8
extra-source-files:
  migrations/*.sql
  templates/*

common warnings
  default-extensions:
    BangPatterns
    BlockArguments
    DataKinds
    DeriveAnyClass
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    LambdaCase
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    TypeApplications
    TypeFamilies
    TypeOperators
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  exposed-modules:
    Hauth.API
    Hauth.API.Auth
    Hauth.API.Types
    Hauth.Auth.Jwt
    Hauth.CLI
    Hauth.Config
    Hauth.Crypto.Password
    Hauth.Email
    Hauth.Env
    Hauth.Migrate
    Hauth.Server
    Hauth.Session
  hs-source-dirs: src
  build-depends:
      aeson >=2.2 && <2.3
    , base >=4.17 && <5
    , base64-bytestring >=1.2 && <1.3
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , crypton >=0.34 && <1.1
    , file-embed >=0.0.15 && <0.1
    , http-api-data >=0.6 && <0.7
    , memory >=0.18 && <0.19
    , mtl >=2.2 && <2.4
    , postgresql-simple >=0.7 && <0.8
    , resource-pool >=0.2.3 && <0.3
    , servant >=0.19 && <0.21
    , servant-server >=0.19 && <0.21
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , uuid >=1.3 && <1.4
    , wai >=3.2 && <3.3
    , warp >=3.3 && <3.5
  default-language: Haskell2010

executable hauth
  import: warnings
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base >=4.17 && <5
    , hauth
  default-language: Haskell2010

test-suite hauth-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
      base >=4.17 && <5
    , aeson >=2.2 && <2.3
    , base64-bytestring >=1.2 && <1.3
    , bytestring >=0.11 && <0.13
    , hauth
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , uuid >=1.3 && <1.4
  default-language: Haskell2010
