cabal-version: 3.4
name: hauth
version: 0.0.0.0
synopsis: Postgres-native authentication service
description:
  Hauth is a Postgres-native authentication service written in Haskell.
author: Thales Maciel
maintainer: Thales Maciel
category: Web
build-type: Simple
tested-with: GHC ==9.4.8

common warnings
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

executable hauth
  import: warnings
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base >=4.17 && <5
  default-language: Haskell2010

test-suite hauth-test
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  build-depends:
    base >=4.17 && <5
  default-language: Haskell2010
