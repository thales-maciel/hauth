cabal-version: 3.4
name: hauth
version: 0.0.0.0
synopsis: Postgres-native authentication service
description:
  Hauth is a Postgres-native authentication service written in Haskell.
author: Thales Maciel
maintainer: Thales Maciel
category: Web
build-type: Simple
tested-with: GHC ==9.4.8
extra-source-files:
  migrations/*.sql
  templates/*

common warnings
  default-extensions:
    BangPatterns
    BlockArguments
    DataKinds
    DeriveAnyClass
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    LambdaCase
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    TypeApplications
    TypeFamilies
    TypeOperators
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  exposed-modules:
    Hauth.API
    Hauth.API.Auth
    Hauth.API.Types
    Hauth.Auth.AalAmr
    Hauth.Auth.Admin
    Hauth.Auth.Jwt
    Hauth.Auth.Login
    Hauth.Auth.Logout
    Hauth.Auth.Recovery
    Hauth.Auth.UserUpdate
    Hauth.Auth.Verify
    Hauth.CLI
    Hauth.Config
    Hauth.Crypto.Password
    Hauth.Email
    Hauth.Email.Templates
    Hauth.Env
    Hauth.Hooks.Runner
    Hauth.Hooks.Types
    Hauth.Identity
    Hauth.Mfa.Totp
    Hauth.Mfa.TotpVerify
    Hauth.MfaFactor
    Hauth.Migrate
    Hauth.OAuth
    Hauth.OAuth.Github
    Hauth.OAuth.Google
    Hauth.Server
    Hauth.Server.Admin
    Hauth.Server.EmailTemplates
    Hauth.Server.Hooks
    Hauth.Server.Mfa
    Hauth.Server.OAuth
    Hauth.Server.WebhookSubscriptions
    Hauth.Session
    Hauth.User
    Hauth.Verify
    Hauth.Verify.Database
    Hauth.Verify.Identity
    Hauth.Verify.Smtp
    Hauth.Verify.Types
    Hauth.Webhooks.Events
    Hauth.Webhooks.Outbox
    Hauth.Webhooks.Signing
  hs-source-dirs: src
  build-depends:
      aeson >=2.2 && <2.3
    , base >=4.17 && <5
    , base64-bytestring >=1.2 && <1.3
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , crypton >=0.34 && <1.1
    , file-embed >=0.0.15 && <0.1
    , http-api-data >=0.6 && <0.7
    , http-client >=0.7 && <0.8
    , http-client-tls >=0.3 && <0.4
    , http-types >=0.12 && <0.13
    , memory >=0.18 && <0.19
    , mtl >=2.2 && <2.4
    , network >=3.1 && <3.3
    , network-uri >=2.6 && <2.7
    , postgresql-simple >=0.7 && <0.8
    , resource-pool >=0.2.3 && <0.3
    , servant >=0.19 && <0.21
    , servant-server >=0.19 && <0.21
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , uuid >=1.3 && <1.4
    , wai >=3.2 && <3.3
    , warp >=3.3 && <3.5
  default-language: Haskell2010

executable hauth
  import: warnings
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base >=4.17 && <5
    , bytestring >=0.11 && <0.13
    , hauth
    , text >=2.0 && <2.2
  default-language: Haskell2010

test-suite hauth-test
  import: warnings
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Spec.APISpec
    Spec.Auth.AalAmrSpec
    Spec.Auth.AdminSpec
    Spec.Auth.JwtSpec
    Spec.Auth.LoginSpec
    Spec.Auth.LogoutSpec
    Spec.Auth.RecoverySpec
    Spec.Auth.ServiceRoleSpec
    Spec.Auth.UserUpdateSpec
    Spec.Auth.VerifySpec
    Spec.CLISpec
    Spec.ConfigSpec
    Spec.Crypto.PasswordSpec
    Spec.Email.TemplatesSchemaSpec
    Spec.EmailSpec
    Spec.Hooks.RunnerSpec
    Spec.Hooks.TypesSpec
    Spec.Mfa.TotpSpec
    Spec.Mfa.VerifySpec
    Spec.MigrateSpec
    Spec.OAuth.GithubSpec
    Spec.OAuth.GoogleSpec
    Spec.OAuthSpec
    Spec.RefreshTokenSpec
    Spec.ServerSpec
    Spec.SessionSpec
    Spec.TestUtils
    Spec.UserSpec
    Spec.Verify.DatabaseSpec
    Spec.Verify.IdentitySpec
    Spec.Verify.SmtpSpec
    Spec.VerifySpec
    Spec.Webhooks.SigningSpec
  build-depends:
      base >=4.17 && <5
    , aeson >=2.2 && <2.3
    , base64-bytestring >=1.2 && <1.3
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , file-embed >=0.0.15 && <0.1
    , hauth
    , http-client >=0.7 && <0.8
    , http-types >=0.12 && <0.13
    , memory >=0.18 && <0.19
    , network >=3.1 && <3.3
    , postgresql-simple >=0.7 && <0.8
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , uuid >=1.3 && <1.4
    , wai >=3.2 && <3.3
    , warp >=3.3 && <3.5
  default-language: Haskell2010

test-suite hauth-e2e
  import: warnings
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: e2e
  other-modules:
    E2E.AdminSpec
    E2E.AuthSpec
    E2E.EmailTemplatesCrudSpec
    E2E.Helpers
    E2E.HooksCrudSpec
    E2E.HooksTypesSpec
    E2E.MfaSpec
    E2E.OAuthSpec
    E2E.RecoverySpec
    E2E.UserSpec
    E2E.VerifyDatabaseSpec
    E2E.WebhookOutboxSpec
    E2E.WebhookSubscriptionsSpec
  build-depends:
      base >=4.17 && <5
    , aeson >=2.2 && <2.3
    , bytestring >=0.11 && <0.13
    , hauth
    , hspec >=2.10 && <2.12
    , http-types >=0.12 && <0.13
    , postgresql-simple >=0.7 && <0.8
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , uuid >=1.3 && <1.4
    , wai >=3.2 && <3.3
    , wai-extra >=3.1 && <3.2
  default-language: Haskell2010
