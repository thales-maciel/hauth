cabal-version: 3.4
name: hauth
version: 0.0.0.0
synopsis: Postgres-native authentication service
description:
  Hauth is a Postgres-native authentication service written in Haskell.
author: Thales Maciel
maintainer: Thales Maciel
category: Web
build-type: Simple
tested-with: GHC ==9.4.8
extra-source-files:
  migrations/*.sql
  templates/*

common warnings
  default-extensions:
    BangPatterns
    BlockArguments
    DataKinds
    DeriveFoldable
    DeriveFunctor
    DeriveGeneric
    DeriveTraversable
    DerivingStrategies
    DerivingVia
    FlexibleContexts
    FlexibleInstances
    GADTs
    GeneralizedNewtypeDeriving
    LambdaCase
    NamedFieldPuns
    OverloadedStrings
    RecordWildCards
    ScopedTypeVariables
    StandaloneDeriving
    StandaloneKindSignatures
    TypeApplications
    TypeFamilies
    TypeOperators
  ghc-options:
    -Wall
    -Wcompat
    -Widentities
    -Wincomplete-record-updates
    -Wincomplete-uni-patterns
    -Wpartial-fields
    -Wredundant-constraints

library
  import: warnings
  exposed-modules:
    Hauth.API
    Hauth.API.Auth
    Hauth.API.Types
    Hauth.API.Types.Admin
    Hauth.API.Types.Auth
    Hauth.API.Types.Common
    Hauth.API.Types.EmailTemplates
    Hauth.API.Types.Health
    Hauth.API.Types.Hooks
    Hauth.API.Types.Mfa
    Hauth.API.Types.OAuth
    Hauth.API.Types.Settings
    Hauth.API.Types.Webhooks
    Hauth.Auth.AalAmr
    Hauth.Auth.Admin
    Hauth.Auth.Jwt
    Hauth.Auth.Login
    Hauth.Auth.Logout
    Hauth.Auth.Recovery
    Hauth.Auth.Role
    Hauth.Auth.UserUpdate
    Hauth.Auth.Verify
    Hauth.CLI
    Hauth.Config
    Hauth.Crypto.Password
    Hauth.Email
    Hauth.Email.TemplateCache
    Hauth.Email.Templates
    Hauth.Env
    Hauth.Hooks.Runner
    Hauth.Hooks.Types
    Hauth.Identity
    Hauth.Mfa.Totp
    Hauth.Mfa.TotpVerify
    Hauth.MfaFactor
    Hauth.Migrate
    Hauth.OAuth
    Hauth.OAuth.Github
    Hauth.OAuth.Google
    Hauth.Server
    Hauth.Server.Admin
    Hauth.Server.Auth
    Hauth.Server.Auth.Recover
    Hauth.Server.Auth.Resend
    Hauth.Server.Auth.Session
    Hauth.Server.Auth.Settings
    Hauth.Server.Auth.Signup
    Hauth.Server.Auth.Token
    Hauth.Server.Auth.Verify
    Hauth.Server.Auth.VerifyError
    Hauth.Server.EmailTemplates
    Hauth.Server.Errors
    Hauth.Server.Health
    Hauth.Server.Hooks
    Hauth.Server.Mfa
    Hauth.Server.OAuth
    Hauth.Server.Session
    Hauth.Server.WebhookDeliveries
    Hauth.Server.WebhookSubscriptions
    Hauth.Session
    Hauth.User
    Hauth.Verify
    Hauth.Verify.Database
    Hauth.Verify.Identity
    Hauth.Verify.Oauth
    Hauth.Verify.Smtp
    Hauth.Verify.Types
    Hauth.Webhooks.Events
    Hauth.Webhooks.Outbox
    Hauth.Webhooks.Signing
    Hauth.Webhooks.Worker
  hs-source-dirs: src
  build-depends:
      aeson >=2.2 && <2.3
    , async >=2.2 && <2.3
    , base >=4.17 && <5
    , base64-bytestring >=1.2 && <1.3
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , crypton >=0.34 && <1.1
    , file-embed >=0.0.15 && <0.1
    , http-api-data >=0.6 && <0.7
    , http-client >=0.7 && <0.8
    , http-client-tls >=0.3 && <0.4
    , http-types >=0.12 && <0.13
    , jose >=0.11 && <0.12
    , lens >=4.19 && <5.4
    , memory >=0.18 && <0.19
    , mtl >=2.2 && <2.4
    , network >=3.1 && <3.3
    , network-uri >=2.6 && <2.7
    , postgresql-simple >=0.7 && <0.8
    , resource-pool >=0.2.3 && <0.3
    , scientific >=0.3 && <0.4
    , servant >=0.19 && <0.21
    , servant-server >=0.19 && <0.21
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , uuid >=1.3 && <1.4
    , wai >=3.2 && <3.3
    , warp >=3.3 && <3.5
  default-language: Haskell2010

executable hauth
  import: warnings
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  main-is: Main.hs
  hs-source-dirs: app
  build-depends:
    base >=4.17 && <5
    , bytestring >=0.11 && <0.13
    , hauth
    , text >=2.0 && <2.2
  default-language: Haskell2010

test-suite hauth-test
  import: warnings
  type: exitcode-stdio-1.0
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  main-is: Main.hs
  hs-source-dirs: test
  other-modules:
    Spec.API.Golden.AdminSpec
    Spec.API.Golden.AuthSpec
    Spec.API.Golden.HealthSpec
    Spec.API.Golden.Helpers
    Spec.API.Golden.HooksSpec
    Spec.API.Golden.MfaSpec
    Spec.API.Golden.SettingsSpec
    Spec.API.Golden.WebhooksSpec
    Spec.API.GoldenSpec
    Spec.APISpec
    Spec.Auth.AalAmrSpec
    Spec.Auth.AdminSpec
    Spec.Auth.CustomAccessTokenSpec
    Spec.Auth.JwtPropertySpec
    Spec.Auth.JwtSpec
    Spec.Auth.LoginSpec
    Spec.Auth.LogoutSpec
    Spec.Auth.RecoverySpec
    Spec.Auth.RoleSpec
    Spec.Auth.ServiceRoleSpec
    Spec.Auth.UserUpdateSpec
    Spec.Auth.VerifySpec
    Spec.CLISpec
    Spec.ConfigRedactionSpec
    Spec.ConfigSpec
    Spec.Crypto.PasswordSpec
    Spec.EmailSpec
    Spec.Hooks.RunnerSpec
    Spec.Hooks.TypesSpec
    Spec.LifecycleSpec
    Spec.Mfa.TotpSpec
    Spec.Mfa.VerifySpec
    Spec.MigrateSpec
    Spec.OAuth.GithubSpec
    Spec.OAuth.GoogleSpec
    Spec.OAuthSpec
    Spec.RefreshTokenSpec
    Spec.ServerSpec
    Spec.SessionSpec
    Spec.TestUtils
    Spec.UserSpec
    Spec.Verify.DatabaseSpec
    Spec.Verify.IdentitySpec
    Spec.Verify.SmtpSpec
    Spec.VerifySpec
    Spec.Verify.OauthSpec
    Spec.Webhooks.SigningSpec
  build-depends:
      base >=4.17 && <5
    , aeson >=2.2 && <2.3
    , base64-bytestring >=1.2 && <1.3
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , crypton >=0.34 && <1.1
    , file-embed >=0.0.15 && <0.1
    , hauth
    , hedgehog >=1.4 && <1.6
    , hspec >=2.11 && <2.12
    , hspec-hedgehog >=0.3 && <0.4
    , http-client >=0.7 && <0.8
    , http-types >=0.12 && <0.13
    , memory >=0.18 && <0.19
    , network >=3.1 && <3.3
    , postgresql-simple >=0.7 && <0.8
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , uuid >=1.3 && <1.4
    , wai >=3.2 && <3.3
    , warp >=3.3 && <3.5
  default-language: Haskell2010

test-suite hauth-e2e
  import: warnings
  ghc-options:
    -threaded
    -rtsopts
    -with-rtsopts=-N
  type: exitcode-stdio-1.0
  main-is: Main.hs
  hs-source-dirs: e2e
  other-modules:
    E2E.AdminSpec
    E2E.AuthSpec
    E2E.CompatibilityPlaceholdersSpec
    E2E.EmailTemplatesCrudSpec
    E2E.EmailTemplatesLoaderSpec
    E2E.EmailTemplatesSchemaSpec
    E2E.EmailTemplatesSpec
    E2E.HealthSpec
    E2E.Helpers
    E2E.HooksCrudSpec
    E2E.HooksSpec
    E2E.HooksTypesSpec
    E2E.MfaSpec
    E2E.MigrateSpec
    E2E.OAuthSpec
    E2E.RecoverySpec
    E2E.UserSpec
    E2E.VerifyDatabaseSpec
    E2E.VerifySpec
    E2E.WebhookDeliveriesSpec
    E2E.WebhookEmitSpec
    E2E.WebhookOutboxSpec
    E2E.WebhooksSpec
    E2E.WebhookSubscriptionsSpec
    E2E.WebhookWorkerSpec
  build-depends:
      base >=4.17 && <5
    , aeson >=2.2 && <2.3
    , async >=2.2 && <2.3
    , bytestring >=0.11 && <0.13
    , containers >=0.6 && <0.8
    , hauth
    , hspec >=2.10 && <2.12
    , http-client >=0.7 && <0.8
    , http-types >=0.12 && <0.13
    , network >=3.1 && <3.3
    , postgresql-simple >=0.7 && <0.8
    , text >=2.0 && <2.2
    , time >=1.12 && <1.15
    , uuid >=1.3 && <1.4
    , wai >=3.2 && <3.3
    , wai-extra >=3.1 && <3.2
    , warp >=3.3 && <3.5
  default-language: Haskell2010
